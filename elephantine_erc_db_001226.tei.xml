         <div type="edition">
            <ab xml:lang="Grek grc">
               <pb n="convex" /><lb n="1" /><persName ref="ancient_persons.xml#15485">Οὔλπιος <surname>Κερεᾶλις</surname></persName> καὶ <persName ref="ancient_persons.xml#26435">Δομ<supplied cert="high" evidence="parallel" reason="lost">ίτιος</supplied>
                  <lb n="2" rend="left-to-right" /><surname>Δομιτίου</surname></persName>
               <rs ref="ancient_titles.xml#id343" type="title"><expan><abbr>μισθωτ</abbr><ex>αὶ</ex></expan></rs> ἱερᾶς π<supplied cert="high" evidence="parallel" reason="lost">ύλ(ης) <placeName ref="places.xml#8">Σοή(νης)</placeName> διὰ</supplied>
               <lb n="3" rend="left-to-right" /><persName ref="ancient_persons.xml#26890">Μινουκίου <surname>Νίγερος</surname></persName>
               <rs ref="ancient_titles.xml#id345" type="title"><expan><abbr>βοη̣θ̣</abbr><ex>οῦ</ex></expan></rs>. <supplied cert="high" evidence="parallel" reason="lost">ἐμέτρησεν</supplied>
               <lb n="4" rend="left-to-right" /><persName ref="ancient_persons.xml#26895">Ταμῆτις</persName>
               <note>ed. Ταμῦτις</note> ὑπὲρ τρίτη̣ς̣ <supplied cert="high" evidence="parallel" reason="lost">νομ(οῦ) μυρο(βαλάνου)</supplied>
               <note>ed. τρίτω[ ̣ ̣ ̣ ̣ ̣ ̣ ̣]</note><lb n="5" rend="left-to-right" /><expan><abbr>γενή</abbr><ex>ματος</ex></expan> ιζ (ἔτους) <expan><abbr>ὀνό</abbr><ex>ματος</ex></expan> Π<supplied cert="high" evidence="parallel" reason="lost"> ̣ ̣ ̣ ̣ ̣ ̣</supplied>
               <lb n="6" rend="left-to-right" />ματίου ἕκτον δ<supplied cert="high" evidence="parallel" reason="lost">ωδέκατον (γίνονται)</supplied>
               <lb n="7" rend="left-to-right" /><expan><abbr>ματ</abbr><ex>ίου</ex></expan>  ϛ´ ιβ´. <date notAfter="+178-08-28" notBefore="+178-08-24" when-custom="Commodus:18">(ἔτους) ι<supplied cert="high" evidence="parallel" reason="lost">η Ἀντωνίνου</supplied>
                  <lb n="8" />Μεσορὴ ἐπα<supplied cert="high" evidence="parallel" reason="lost">γομένων  ̣</supplied></date>.  </ab>
         </div>
         <div type="translation" xml:lang="en">
            <ab xml:lang="Latn en">
               <pb n="convex" /><lb n="1" />Ulpius Cerealis and Domitius, <lb n="2" rend="left-to-right" />Domitius, tax farmers of the Sacred Gate of Syene, through<lb n="3" rend="left-to-right" />Minucius Niger, assistant. Thus has delivered <lb n="4" rend="left-to-right" />Tametis, for the third of the nome for behen-nuts <lb n="5" rend="left-to-right" />of the harvest of year 17, on account of  P--- <lb n="6" rend="left-to-right" />one sixth and one thwelfth of a mation, = <lb n="7" rend="left-to-right" />1/6 1/12 mat. Year 18 of Antoninus,<lb n="8" rend="left-to-right" />Mesore epagomene ?. </ab>
         </div>
