         <div type="edition">
            <ab xml:lang="Grek grc">
               <pb n="convex" /><lb n="1" rend="left-to-right" /><date notAfter="-77-06-07" notBefore="-77-05-09" when-custom="Ptolemaios_XII:4">ἔτους δ Παχὼν</date>
               <lb n="2" rend="left-to-right" /><expan><abbr>μεμέτρη</abbr><ex>κεν</ex></expan>
               <note> μ corr. ex εισ</note> ὑπὲρ το <note> l. τοῦ</note>
               <expan><abbr>αὐ</abbr><ex>τοῦ</ex></expan>  (ἔτους) <lb n="3" rend="left-to-right" /><persName ref="ancient_persons.xml#4059">Πατῆς</persName> καὶ ὁ ἀδε- <lb break="no" n="4" rend="left-to-right" />λφὸς μυροβαλάνου <lb n="5" rend="left-to-right" /><expan><abbr>χοί</abbr><ex>νικα</ex></expan>  α (γίνεται) <expan><abbr>μυ</abbr><ex>ρο</ex></expan>
               <expan><abbr>βα</abbr><ex>λάνου</ex></expan>
               <expan><abbr>χοῖ</abbr><ex>νιξ</ex></expan>  α. <lb n="6" rend="left-to-right" /><persName ref="ancient_persons.xml#25580"><expan><abbr>Σαρα</abbr><ex>πίων</ex></expan></persName>  ὁ παρὰ <persName ref="ancient_persons.xml#25585"><expan><abbr>Πραξ</abbr><ex>?</ex></expan></persName> . </ab>
         </div>
         <div type="translation" xml:lang="en">
            <ab xml:lang="Latn en">
               <pb n="convex" /><lb n="1" rend="left-to-right" />Year 4, Pachon.<lb n="2" rend="left-to-right" />Thus has measured for the same year<lb n="3" rend="left-to-right" />Pates and his <lb n="4" rend="left-to-right" />brother, the tax for behen-nuts<lb n="5" rend="left-to-right" />1 choinix, = 1 choinix of behen-nuts.<lb n="6" rend="left-to-right" />Sarapion, the clerk of Prax(iades?) </ab>
         </div>
