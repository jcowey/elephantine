            <ab xml:lang="Egyd-Egydmd egy-demp">
               <pb n="R" /><lb n=" x+1 " />ḏd=w <gap extent="unknown" reason="lost" />
               <lb n="x+2 " />ḫr ı͗r=w ḫnṱ ı͗rm=f <lb n="x+3 " />n wꜥ.t md(.t) bn-ı͗w <persName ref="ancient_persons.xml#p1725">Pꜣ-ḏı͗-Mḥ(y.t)</persName>
               <lb n="x+4 " />ẖn nꜣ rmṯ.w nty-ı͗w=w mḥṱ n <lb n="x+5 " />ḏr.t.ṱ=w n md(.t) ı͗n wn <lb n="x+6 " />wꜥ.t šꜥ.t ı͗w ı͗r s <rs ref="ancient_titles.xml#idt20" type="title">nꜣ wꜥb.w</rs>
               <lb n="x+7 " />ı͗.ı͗r-ḥr <rs ref="ancient_titles.xml#idt20" type="title">nꜣ wꜥb.w</rs> st ı͗r-rḫ <lb n="x+8 " />pꜣ nḫt.ṱ <damage degree="high">nty</damage> ḫpr bn-pw=y <lb n="x+9 " />rḫ <supplied cert="high" reason="omitted">ḏı͗.t</supplied> ı͗w-ı͗w.w <rs ref="ancient_titles.xml#idt20" type="title">wꜥb</rs> r rsy <lb n="x+10 " /><rs ref="ancient_titles.xml#idt286" type="title">nꜣ wꜥb.w (n) Wsı͗r</rs> nty ı͗r <rs ref="ancient_titles.xml#idt119" type="title">wꜥb n H̱nm</rs>
               <lb n="x+11" />nty dy šn=w s (r-)dbꜣ.ṱ=f <lb n="x+12 " />mtr=w ı͗r=w wꜥ.t šꜥ(.t) <lb n="x+13 " />ı͗.ı͗r-ḥr <rs ref="ancient_titles.xml#idt20" type="title">nꜣ wꜥb.w</rs> ꜥn <lb n="x+14 " />my ḥn=w s ı͗.ı͗r-ḥr <lb n="x+15 " /><rs ref="ancient_titles.xml#idt219" type="title">pꜣ mr-šn</rs> r ḏı͗.t ı͗r=y <lb n="x+16 " />swn tꜣ md.t-rmṯ-nmḥ <lb n="x+17 " />nty-ı͗w=w r ı͗r=s n <persName ref="ancient_persons.xml#p1725">Pꜣ-ḏı͗-Mḥ(y.t)</persName>
               <note>Den Brinker / Muhs / Vleeming, DBL (2005), 53, also concerning the abouve mentioned readings Pꜣ-ḏı͗-Tfn.t und Pꜣ-ḏı͗-tpı͗(?).</note>
